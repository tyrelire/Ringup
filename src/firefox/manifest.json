{
    "manifest_version": 2,
    "name": "Ringup",
    "version": "1.0.0",
    "description": "Keeps Ring Live View running by reconnecting it automatically.",
    "author": "tyrelire",
    "homepage_url": "https://github.com/tyrelire/Ringup",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://account.ring.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "ringup@tyrelire.github.io",
            "strict_min_version": "58.0"
        }
    }
}
