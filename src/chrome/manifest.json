{
    "manifest_version": 3,
    "name": "Ringup",
    "version": "1.0.0",
    "description": "Keeps Ring Live View running by reconnecting it automatically.",
    "homepage_url": "https://github.com/tyrelire/Ringup",
    "permissions": [
        "debugger",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://account.ring.com/*"
            ],
            "js": [
                "keepalive.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://account.ring.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    }
}
